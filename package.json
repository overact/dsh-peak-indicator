{
  "name": "dsh-peak-indicator",
  "version": "0.1.1",
  "private": true,
  "description": "DeepSeek Peak / Off-Peak Time Banner & Indicator for DSH Web GUI (live status, timezone auto-detection, countdown, SVG icons, discount rules)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "README.i18n.yaml",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "type": "module"
}
